{
  "manifest_version": 3,
  "name": "Magister Sync Extension",
  "version": "1.0.0",
  "description": "Syncs Magister calendar and grades data to your learning platform",
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*.magister.net/*",
    "https://zbppznuwwcjdbdbkexyq.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.magister.net/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["interceptor.js"],
      "matches": ["https://*.magister.net/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
