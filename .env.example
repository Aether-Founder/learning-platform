# Supabase Environment Variables Template
# 
# IMPORTANT: This file contains EXAMPLE values only.
# Copy this to .env.local and replace with your ACTUAL credentials.
#
# Get your credentials from: https://app.supabase.com/project/_/settings/api

# Public keys (safe to expose in browser - protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key

# Server-side only keys (NEVER commit these to git or expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-service-key
WEBHOOK_SECRET=your-custom-webhook-secret-string

# Setup Instructions:
# 1. Run: cp .env.example .env.local
# 2. Replace ALL placeholder values above with your actual Supabase credentials
# 3. Restart your development server: npm run dev
#
# For Vercel deployment:
# Add these same variables in Vercel Project Settings > Environment Variables
